NODE_ENV=development
PORT=4000

# Leave empty in development to auto-start an in-memory MongoDB (data resets on restart).
# Examples:
#   mongodb://127.0.0.1:27017
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=
MONGODB_DB_NAME=talentscout

# Must be at least 32 characters in production
JWT_SECRET=replace-with-a-long-random-string-please
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Artificial delays so streaming/evaluation progress is visible in the UI
STREAM_DELAY_MS=30
EVALUATION_DELAY_MS=900
